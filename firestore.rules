rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read for events, categories, settings, flyers and shared calendars
    // This guarantees that public PDF views, QR code scans, mobile calendars and shared schedules
    // remain accessible 24/7 even when computer is off.
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /shared_calendars/{shareId} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
